TRADESENTINEL_ENVIRONMENT=development
TRADESENTINEL_DATABASE_URL=postgresql+asyncpg://tradesentinel:tradesentinel@postgres:5432/tradesentinel
TRADESENTINEL_REDIS_URL=redis://redis:6379/0
TRADESENTINEL_PERSISTENCE_BACKEND=postgres
TRADESENTINEL_EVENT_BACKEND=redis
TRADESENTINEL_CACHE_BACKEND=redis
TRADESENTINEL_CORS_ORIGINS=["http://localhost:3000"]
TRADESENTINEL_MARKET_DATA_PROVIDERS=[]
TRADESENTINEL_NEWS_PROVIDERS=[]
TRADESENTINEL_SENTIMENT_PROVIDERS=[]
TRADESENTINEL_ECONOMIC_DATA_PROVIDERS=[]
TRADESENTINEL_FUNDAMENTALS_PROVIDERS=[]
TRADESENTINEL_STOCK_QUOTE_CACHE_TTL_SECONDS=15
TRADESENTINEL_STOCK_HISTORY_CACHE_TTL_SECONDS=21600
TRADESENTINEL_STOCK_ACTIONS_CACHE_TTL_SECONDS=86400
TRADESENTINEL_RESEARCH_DOCUMENT_FETCH_LIMIT=10
TRADESENTINEL_RESEARCH_EVIDENCE_EXCERPT_LENGTH=280
TRADESENTINEL_RESEARCH_EXTRACTION_VERSION=rules-v1
TRADESENTINEL_RESEARCH_DEFAULT_SEARCH_LIMIT=20
NEXT_PUBLIC_API_URL=http://localhost:8000
